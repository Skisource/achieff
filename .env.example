# Optional overrides. Compose already sets the data directory and publishes
# host port 10000 to container port 8080. Copy to .env only when you need
# to change a value. .env is gitignored.

# production hides /dev/art. Use development when you want the art preview.
ACHIEFF_ENV=production

# Change this before the app is reachable beyond your own machine.
ACHIEFF_SECRET_KEY=dev-only-change-me

# Used once, when the database has no admin, to create the first admin.
# The one-time key is printed in the container logs.
ACHIEFF_BOOTSTRAP_ALIAS=
